{
  "name": "jev-context",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.19.0" },
  "scripts": {
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "eval:retrieval": "node --import tsx eval/retrieval.ts",
    "eval:contextbench": "node --import tsx eval/contextbench-fixture.ts",
    "pilot": "node --import tsx eval/cli.ts",
    "pilot:live": "node --env-file=.env --import tsx eval/cli.ts --live",
    "pilot:paired:live": "node --env-file=.env --import tsx eval/cli.ts --paired --live"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@types/node": "22.20.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
